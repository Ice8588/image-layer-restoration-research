      "data_range": 255,
      "higher_is_better": true
    }
  },
  "aggregation": {
    "seed_order": "seed_first_then_sample",
    "overall": "class_macro",
    "paired_difference": "left_minus_right",
    "lpips_lower_is_better": true
  },
  "bootstrap": {
    "iterations": 10000,
    "seed": 20260711
  },
  "roi_fallback": {
    "field": "scoring_mode",
    "modes": [
      "located",
      "target_bbox_fallback"
    ],
    "rule": "when locate_prediction_b returns roi_status='roi_failure' (no_foreground_component, no_anchor_overlap, or implausible_area_ratio), the row is still scored: the target is normalized as usual via normalize_object_roi(target_rgb, b_amodal_mask), and the prediction is normalized with the same target-side mask via normalize_object_roi(pred_rgb, b_amodal_mask) instead of the (failed) located component mask. LPIPS/PSNR/SSIM are computed on that pair like any other row. The row keeps roi_status='roi_failure' and its reason for failure visibility; it is not excluded from any aggregate."
  },
